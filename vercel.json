{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "npm run build:vercel",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:vercel --workspace=apps/admin",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "mobile": {
      "root": "apps/mobile",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:vercel --workspace=apps/mobile",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "rewrites": [
        { "source": "/service/:id", "destination": "/service/[id].html" },
        { "source": "/transaction/:id", "destination": "/transaction/[id].html" },
        { "source": "/auth", "destination": "/auth/index.html" },
        { "source": "/auth/otp", "destination": "/auth/otp.html" },
        { "source": "/international", "destination": "/international/index.html" },
        { "source": "/transfers", "destination": "/transfers/index.html" },
        { "source": "/support", "destination": "/support/index.html" },
        { "source": "/support/faq", "destination": "/support/faq.html" },
        { "source": "/payment/confirm", "destination": "/payment/confirm.html" },
        { "source": "/payment/select-provider", "destination": "/payment/select-provider.html" },
        { "source": "/profile/devices", "destination": "/profile/devices.html" },
        { "source": "/profile/identity", "destination": "/profile/identity.html" },
        { "source": "/profile/settings", "destination": "/profile/settings.html" },
        { "source": "/services", "destination": "/services.html" },
        { "source": "/activity", "destination": "/activity.html" },
        { "source": "/profile", "destination": "/profile.html" },
        { "source": "/((?!_expo/|assets/).*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build:packages && npm run build --workspace=apps/api",
      "functions": {
        "src/**": {
          "maxDuration": 30
        }
      }
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1",
      "destination": { "service": "api" }
    },
    {
      "source": "/v1/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/api",
      "destination": { "service": "api" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "api" }
    },
    {
      "source": "/app",
      "destination": { "service": "mobile", "path": "/" }
    },
    {
      "source": "/app/(.*)",
      "destination": { "service": "mobile", "path": "/$1" }
    },
    {
      "source": "/admin",
      "destination": { "service": "admin", "path": "/" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "admin", "path": "/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
