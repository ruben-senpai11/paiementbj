{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "npm run build:vercel",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/((?!assets/|.*\\.[^/]+$).*)", "destination": "/index.html" }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:vercel --workspace=apps/admin",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/admin", "destination": "/admin/index.html" },
        { "source": "/admin/", "destination": "/admin/index.html" },
        { "source": "/admin/((?!assets/|.*\\.[^/]+$).*)", "destination": "/admin/index.html" }
      ]
    },
    "mobile": {
      "root": "apps/mobile",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build:vercel --workspace=apps/mobile",
      "devCommand": "npm run dev:vercel",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "rewrites": [
        { "source": "/app", "destination": "/app/index.html" },
        { "source": "/app/", "destination": "/app/index.html" },
        { "source": "/app/service/:id", "destination": "/app/service/[id].html" },
        { "source": "/app/transaction/:id", "destination": "/app/transaction/[id].html" },
        { "source": "/app/auth", "destination": "/app/auth/index.html" },
        { "source": "/app/auth/otp", "destination": "/app/auth/otp.html" },
        { "source": "/app/international", "destination": "/app/international/index.html" },
        { "source": "/app/transfers", "destination": "/app/transfers/index.html" },
        { "source": "/app/support", "destination": "/app/support/index.html" },
        { "source": "/app/support/faq", "destination": "/app/support/faq.html" },
        { "source": "/app/payment/confirm", "destination": "/app/payment/confirm.html" },
        { "source": "/app/payment/select-provider", "destination": "/app/payment/select-provider.html" },
        { "source": "/app/profile/devices", "destination": "/app/profile/devices.html" },
        { "source": "/app/profile/identity", "destination": "/app/profile/identity.html" },
        { "source": "/app/profile/settings", "destination": "/app/profile/settings.html" },
        { "source": "/app/services", "destination": "/app/services.html" },
        { "source": "/app/activity", "destination": "/app/activity.html" },
        { "source": "/app/profile", "destination": "/app/profile.html" },
        { "source": "/app/((?!_expo/|assets/|.*\\.[^/]+$).*)", "destination": "/app/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && npm install --legacy-peer-deps",
      "buildCommand": "cd ../.. && npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build:packages && npm run build --workspace=apps/api",
      "functions": {
        "src/**": {
          "maxDuration": 30
        }
      }
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.mobileconfig",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"PaiementBJ-iPhone.mobileconfig\"" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1",
      "destination": { "service": "api" }
    },
    {
      "source": "/v1/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/api",
      "destination": { "service": "api" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "api" }
    },
    {
      "source": "/app",
      "destination": { "service": "mobile" }
    },
    {
      "source": "/app/(.*)",
      "destination": { "service": "mobile" }
    },
    {
      "source": "/admin",
      "destination": { "service": "admin" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
