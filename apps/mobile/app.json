{
  "expo": {
    "name": "Paiement BJ",
    "slug": "paiement-bj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "paiementbj",
    "userInterfaceStyle": "light",
    "backgroundColor": "#003F2B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.paiement.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sécuriser l’ouverture de votre espace Paiement BJ par biométrie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064B32"
      },
      "package": "bj.paiement.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
