# ==============================================================================
# PAIEMENT BJ — CONFIGURATION D'ENVIRONNEMENT (EXEMPLE SANS SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT GÉNÉRAL
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_NAME="Paiement BJ"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (POSTGRESQL 18) & CACHE (REDIS)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paiementbj?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. SÉCURITÉ & SESSIONS JWT
# ------------------------------------------------------------------------------
# Générer des secrets forts de 64 caractères minimum en production
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_SECRET_ACCESS_TOKEN_PAIEMENT_BJ"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_SECRET_REFRESH_TOKEN_PAIEMENT_BJ"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# 4. FOURNISSEUR SMS / OTP (AUTHENTIFICATION TÉLÉPHONIQUE)
# Modes: "sandbox" (affiche le code dans les logs serveurs sécurisés) | "twillio" | "infobip" | "local_telecom"
# ------------------------------------------------------------------------------
SMS_PROVIDER=sandbox
SMS_SENDER_NAME="PaiementBJ"
SMS_API_KEY=""
SMS_API_SECRET=""
OTP_EXPIRY_SECONDS=180
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 5. CONNECTEURS PRESTATAIRES DE PAIEMENT (SANDBOX OFFICIELLES)
# Note : Aucune clé de production n'est stockée ici.
# ------------------------------------------------------------------------------

# MTN Mobile Money (MoMo Developer Sandbox)
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_CALLBACK_HOST="http://localhost:4000"
MTN_MOMO_WEBHOOK_SECRET=""

# Moov Money Bénin (Sandbox Partenaire)
MOOV_MONEY_ENVIRONMENT=sandbox
MOOV_MONEY_API_KEY=""
MOOV_MONEY_MERCHANT_ID=""
MOOV_MONEY_WEBHOOK_SECRET=""

# Celtiis Cash Bénin (Sandbox Partenaire)
CELTIIS_CASH_ENVIRONMENT=sandbox
CELTIIS_CASH_API_KEY=""
CELTIIS_CASH_MERCHANT_ID=""
CELTIIS_CASH_WEBHOOK_SECRET=""

# Passerelle Cartes Bancaires (Visa / Mastercard)
CARD_GATEWAY_ENVIRONMENT=sandbox
CARD_GATEWAY_PUBLIC_KEY=""
CARD_GATEWAY_SECRET_KEY=""
CARD_GATEWAY_WEBHOOK_SECRET=""

# Télépaiement Trésor Public Bénin
TRESOR_PUBLIC_ENVIRONMENT=sandbox
TRESOR_PUBLIC_API_KEY=""
TRESOR_PUBLIC_ENDPOINT="https://paiement.tresorbenin.bj/api/v1"
TRESOR_PUBLIC_WEBHOOK_SECRET=""

# Passerelle Cartes Bancaires (URL de paiement hébergé)
CARD_GATEWAY_CHECKOUT_URL=""

# ------------------------------------------------------------------------------
# 6. BACK-OFFICE ADMINISTRATEUR (GOUVERNANCE RBAC)
# Hash scrypt générable côté serveur — laisser vide en production si comptes en base Prisma
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD_HASH=""
ADMIN_BOOTSTRAP_NAME="Opérateur Gouvernance"
ADMIN_BOOTSTRAP_ROLE="SUPERADMIN"

# ------------------------------------------------------------------------------
# 7. APPLICATION MOBILE & WEB (EXPO PUBLIC CONFIG)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# 8. PORTAIL DE DISTRIBUTION STORES (apps/web)
# Laisser vide tant que les publications Play Console / App Store Connect ne sont pas actives
# ------------------------------------------------------------------------------
VITE_PLAY_STORE_URL=""
VITE_APP_STORE_URL=""
VITE_WEB_APP_URL=""
